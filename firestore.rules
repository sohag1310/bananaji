rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Customer Orders
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Products catalog
    match /products/{productId} {
      allow read, write: if true;
    }

    // Hero banners
    match /hero_banners/{bannerId} {
      allow read, write: if true;
    }

    // Blog posts
    match /blog_posts/{postId} {
      allow read, write: if true;
    }

    // Site and filter configurations
    match /site_config/{configId} {
      allow read, write: if true;
    }

    match /filter_config/{configId} {
      allow read, write: if true;
    }

    match /site_content/{contentId} {
      allow read, write: if true;
    }

    match /admin_config/{configId} {
      allow read, write: if true;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}

